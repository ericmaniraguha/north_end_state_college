{
  "name": "north-end-college",
  "version": "2.0.0",
  "description": "North End College website and admin dashboard: React (Vite) frontend, Express API, SQLite database with migrations",
  "main": "backend/server.js",
  "scripts": {
    "dev": "node --watch-path=backend backend/server.js --dev",
    "build": "vite build --config frontend/vite.config.mjs",
    "start": "node backend/server.js",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --test \"backend/tests/**/*.test.js\"",
    "test:web": "vitest run --config frontend/vite.config.mjs",
    "migrate": "node backend/migrate.js up",
    "migrate:status": "node backend/migrate.js status",
    "migrate:rollback": "node backend/migrate.js down",
    "seed": "node backend/seeds/seed.js",
    "setup": "node backend/migrate.js up && node backend/seeds/seed.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
