{
  "name": "north-end-college",
  "version": "2.0.0",
  "description": "North End College website and admin dashboard: React (Vite) frontend, Express API, SQLite database, email/WhatsApp/SMS messaging",
  "main": "backend/server.js",
  "scripts": {
    "dev": "node --watch-path=backend backend/server.js --dev",
    "build": "vite build --config frontend/vite.config.mjs",
    "start": "node backend/server.js",
    "migrate": "node backend/migrate.js up",
    "migrate:status": "node backend/migrate.js status",
    "migrate:rollback": "node backend/migrate.js down",
    "seed": "node backend/seeds/seed.js",
    "setup": "node backend/migrate.js up && node backend/seeds/seed.js",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
