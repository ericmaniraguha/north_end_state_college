# Copy this file to .env and fill in the values. Never commit .env.
# Values go after "=" with no spaces around it. Put comments on their own line.

PORT=3000
DB_PATH=data/college.db
# Long random secret used to sign in to /admin
ADMIN_TOKEN=change-me
# Public address of the site, used in sitemap.xml (leave empty for local development)
SITE_URL=

# ============================================
# EMAIL/SMTP CONFIGURATION
# ============================================
# Gmail: smtp.gmail.com, port 587, your address, and an app password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Name shown as the sender
SMTP_FROM_NAME=North End College

# ============================================
# WHATSAPP (Meta WhatsApp Cloud API)
# ============================================
# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template with one body variable {{1}}. Needed to message people
# who haven't written to the college on WhatsApp in the last 24 hours.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0

# ============================================
# SMS
# ============================================
# africastalking or twilio. Leave empty to use whichever has credentials below.
SMS_PROVIDER=

# Africa's Talking (account.africastalking.com). Use the username "sandbox" to test for free.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional registered sender ID, e.g. NEC
AFRICASTALKING_SENDER_ID=

# Twilio (console.twilio.com). Set either the "from" number or a messaging service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ============================================
# AUTOMATIC MESSAGES
# ============================================
# Channels used for automatic messages, in order; channels without settings are skipped.
# Remove whatsapp or sms here if you set up both and don't want applicants to get two texts.
NOTIFY_CHANNELS=email,whatsapp,sms
# Message the applicant after they apply, and when they are accepted or rejected
NOTIFY_APPLICANT_CONFIRMATION=true
NOTIFY_APPLICANT_DECISION=true
# Alert staff about new applications and contact messages
NOTIFY_STAFF=true
# Who receives staff alerts, comma-separated
STAFF_ALERT_EMAILS=
STAFF_ALERT_PHONES=
